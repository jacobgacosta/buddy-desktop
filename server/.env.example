# ─────────────────────────────────────────────
#  buddy-server — environment variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────

# Claude API (required for screencap/vision analysis via /context/screenshot)
ANTHROPIC_API_KEY=sk-ant-...

# ── Local LLM ─────────────────────────────────
# LM Studio or Ollama endpoint
OLLAMA_URL=http://localhost:11434
# Model name loaded in LM Studio / Ollama
LLM_MODEL=llama3.2:3b

# ── TTS — ElevenLabs (optional) ───────────────
# If set, Piper Docker is not needed and start.ps1 skips it.
# Requires a paid plan to use library voices via API.
ELEVENLABS_API_KEY=
# Default voice: Georges — change to any ElevenLabs voice ID
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ── STT — Whisper (Docker, port 8080) ─────────
WHISPER_URL=http://localhost:8080
# Transcription language
WHISPER_LANG=es
# Hint to help Whisper recognise the wake word
WHISPER_PROMPT=buddy

# ── TTS — Piper fallback (Docker, port 5200) ──
PIPER_URL=http://localhost:5200

# ── Server ────────────────────────────────────
PORT=7788
