{
  "name": "@buddy/desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-sidecar": "node -e \"const fs=require('fs'),p='src-tauri';['gnu','msvc'].forEach(t=>{const s=`${p}/binaries/buddy-server-x86_64-pc-windows-${t}.exe`,d=`${p}/target/debug/buddy-server-x86_64-pc-windows-${t}.exe`;try{fs.copyFileSync(s,d)}catch{}})\"",
    "dev": "pnpm copy-sidecar && tauri dev",
    "vite": "vite",
    "build": "tauri build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@buddy/core": "workspace:*",
    "@buddy/renderer": "workspace:*",
    "@buddy/types": "workspace:*",
    "@rive-app/react-canvas": "^4.36.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
